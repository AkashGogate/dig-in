# Coordination mock baseline needs no credentials.
# Start one backend on port 8000, static frontend on 5173.
# API base URL is configured in frontend/config.js (not automatically read here).
# Use the shared host's reachable URL for phones/hardware; localhost is device-local.

# Optional legacy Deepgram microphone / real prerecorded eval only.
# Keep unset for credential-free coordination demo and mock eval.
# DEEPGRAM_API_KEY=

# Optional legacy /session/start Basic Auth cost gate; set BOTH together.
# These do not implement production coordination staff authentication.
# DEMO_AUTH_USER=
# DEMO_AUTH_PASS=

# Future adapters (ElevenLabs, UNO Q, positioning, Databricks, POS) intentionally
# have no active env vars until their implementations define/validate them.
# Do not put secrets in frontend files or commit a local .env.
