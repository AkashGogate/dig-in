# MVP v2 runs without credentials. Backend8000, static frontend5173.
# This file is not loaded automatically. Copy to ignored .env and deliberately
# use `uvicorn --env-file ../.env` from backend, or export shell variables.
# frontend/config.js sets the browser API host; localhost is device-local.

# Reviewed canonical JSON menu; relative path is from the backend working dir.
DIG_IN_MENU_PATH=fixtures/menus/starter.json
# Eight-dish menu matching the DIG IN artwork (unspecified kitchen data stays null):
# DIG_IN_MENU_PATH=fixtures/menus/dig-in.json
# Second menu has unknown kitchen fields and loads without parser code changes:
# DIG_IN_MENU_PATH=fixtures/menus/second.json

# Automatic menu vector indexing. Local is offline lexical hashing, not semantic AI.
DIG_IN_EMBEDDINGS_MODE=local
# Optional PAID semantic adapter: enable only deliberately; never put keys in frontend.
# DIG_IN_EMBEDDINGS_MODE=openai
# DIG_IN_EMBEDDINGS_MODEL=text-embedding-3-small
# DIG_IN_EMBEDDINGS_API_KEY=

# Background analytics export, never I/O in operational requests.
# fake | jsonl | disabled. No live Databricks adapter/credentials are implemented.
DIG_IN_ANALYTICS_MODE=fake
DIG_IN_ANALYTICS_FAKE_FAILURES=0
# Local JSONL mode: one writer; exported rows persist, pending outbox does not.
DIG_IN_ANALYTICS_JSONL=outputs/mvp-events.jsonl

# Site access: set the SAME secrets on Fly and Vercel, not in config.js.
# Both unset permits local development; partial/Fly deployment fails closed.
DEMO_AUTH_USER=
DEMO_AUTH_PASS=
# DIG_IN_REQUIRE_AUTH=1
# Optional explicit cross-origin HTTP clients; production UI uses same-origin /api.
# DIG_IN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Voice remains a free transcript simulator unless BOTH live flag and key are set.
DEEPGRAM_API_KEY=
DIG_IN_VOICE_LIVE=0
# DIG_IN_REQUIRE_DIETARY_CHECK=1
# In-memory spend guards reset on restart; provider account caps remain necessary.
# DIG_IN_VOICE_MAX_STREAM_SECONDS=30
# DIG_IN_VOICE_DAILY_MINUTES=30
# DIG_IN_VOICE_STREAMS_PER_IP_HOUR=40
# DIG_IN_VOICE_MAX_CONCURRENT=3
# DIG_IN_DEEPGRAM_USD_PER_MINUTE=0.0077
# Legacy binary audio is disabled; scenarios are preserved. Use the bounded v2 path.

# Local OCR: installed Swift on macOS, Poppler/Tesseract in Linux container.
# Requested spoken summaries use explicit browser/device voices.
# CV producer is separately opt-in; see docs/CV_INTEGRATION.md for calibration,
# actor/session credentials, capture-time bindings and mock/camera commands.
# No live Databricks warehouse, payments or positioning configuration exists.
# Never commit credentials, raw frames or recordings.
